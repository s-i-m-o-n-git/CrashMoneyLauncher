{
    "name": "crashmoney-launcher",
    "productName": "CrashMoney",
    "version": "2.0.7",
    "description": "Launcher Minecraft pour le serveur CrashMoney",
    "main": "src/app.js",
    "author": "Simon",
    "url": "CHANGE URL SERVER HERE",
    "scripts": {
        "start": "cross-env-shell NODE_ENV=dev electron .",
        "dev": "cross-env-shell DEV_TOOL=open nodemon --exec npm start",
        "build": "electron-builder",
        "icon": "node build.js --icon=src/assets/images/icon.ico"
    },
    "license": "UNLICENSED",
    "nodemonConfig": {
        "ext": "js,html,css",
        "ignore": "**/test"
    },
    "dependencies": {
        "crashmoney-launcher": "file:",
        "electron-updater": "^6.1.8",
        "minecraft-java-core": "^3.10.4",
        "node-bdd": "^2.0.4",
        "node-fetch": "^2.7.0",
        "xml-js": "^1.6.11"
    },
    "devDependencies": {
        "cross-env": "^7.0.3",
        "electron": "^30.0.9",
        "electron-builder": "^24.13.3",
        "javascript-obfuscator": "^4.1.0",
        "jimp": "^0.22.12",
        "nodemon": "^3.1.2",
        "png2icons": "^2.0.1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/s-i-m-o-n-git/CrashMoneyLauncher.git"
    },
    "bugs": {
        "url": "https://github.com/s-i-m-o-n-git/CrashMoneyLauncher/issues"
    },
    "homepage": "https://github.com/s-i-m-o-n-git/CrashMoneyLauncher#readme",
    "build": {
        "appId": "fr.simon.crashmoney.launcher",
        "productName": "CrashMoney",
        "win": {
            "target": "portable",
            "icon": "src/assets/images/icon.ico"
        },
        "directories": {
            "output": "dist"
        },
        "files": [
            "src/**/*",
            "node_modules/**/*",
            "package.json"
        ]
    }
}
